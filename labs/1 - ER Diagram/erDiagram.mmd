---
config:
  layout: elk
---
erDiagram
    USERS |o--o{ VENUE : "suggests"
    CITY ||--o{ VENUE : "contains"
    VENUE ||--o{ VENUE_VENUE_TYPE : "classified by"
    VENUE_TYPE ||--o{ VENUE_VENUE_TYPE : "assigned to"
    VENUE ||--o{ VENUE_FEATURE : "has"
    FEATURE ||--o{ VENUE_FEATURE : "assigned to"
    USERS ||--o{ FAVORITE : "favorites"
    VENUE ||--o{ FAVORITE : "is favorited"
    VENUE ||--o{ WORKING_HOURS : "open during"
    VENUE ||--o{ MENU_ITEM : "offers"
    VENUE ||--o{ MODERATION_ACTION : "reviewed via"
    USERS ||--o{ MODERATION_ACTION : "performs"
    USERS |o--o{ REVIEW : "writes"
    VENUE ||--o{ REVIEW : "receives"
    REVIEW ||--o{ REVIEW_COMMENT : "has"
    USERS |o--o{ REVIEW_COMMENT : "writes"
    REVIEW_COMMENT |o--o{ REVIEW_COMMENT : "replies to"
    REVIEW |o--o{ PHOTO : "illustrated by"
    VENUE |o--o{ PHOTO : "shown in"
    USERS |o--o{ PHOTO : "uploads"
    USERS |o--o{ REPORT : "files"
    REVIEW |o--o{ REPORT : "target"
    REVIEW_COMMENT |o--o{ REPORT : "target"
    VENUE |o--o{ REPORT : "target"
    USERS ||--o{ VENUE_CLAIM : "submits"
    USERS |o--o{ VENUE_CLAIM : "verifies"
    VENUE ||--o{ VENUE_CLAIM : "claimed in"
    VENUE ||--o{ VENUE_STAFF : "managed by"
    USERS ||--o{ VENUE_STAFF : "works at"
    VENUE ||--o{ PROMOTION : "advertised by"
    USERS |o--o{ PROMOTION : "creates"
    USERS |o--o{ PROMOTION : "reviews"
    PROMOTION ||--o{ PROMOTION_STAT : "measured by"

    USERS {
        int user_id PK
        string email UK
        text pass_hash
        string display_name
        text avatar_url "nullable"
        enum role "user, moderator, admin"
        enum status "active, deleted"
        timestamptz created_at
        timestamptz deleted_at "nullable"
    }
    CITY {
        int city_id PK
        string name
        string region
    }
    VENUE {
        int venue_id PK
        int city_id FK
        int created_by FK "nullable"
        enum status "pending, approved, rejected"
        string name
        text description
        text address
        double latitude
        double longitude
        string phone_number
        text website
        timestamptz created_at
    }
    VENUE_TYPE {
        int venue_type_id PK
        string name UK
    }
    VENUE_VENUE_TYPE {
        int venue_id PK, FK
        int venue_type_id PK, FK
    }
    FEATURE {
        int feature_id PK
        string name UK
    }
    VENUE_FEATURE {
        int venue_id PK, FK
        int feature_id PK, FK
    }
    FAVORITE {
        int user_id PK, FK
        int venue_id PK, FK
        timestamptz created_at
    }
    WORKING_HOURS {
        int working_hours_id PK
        int venue_id FK
        smallint weekday "1-7"
        time opens_at
        time closes_at
    }
    MENU_ITEM {
        int menu_item_id PK
        int venue_id FK
        string name
        text description
        decimal price
        boolean is_available
    }
    MODERATION_ACTION {
        int moderation_action_id PK
        int venue_id FK
        int moderator_id FK
        enum action "approve, reject, request_changes"
        text note
        timestamptz created_at
    }
    REVIEW {
        int review_id PK
        int venue_id FK
        int user_id FK "nullable"
        smallint rating "1-10"
        text text
        date visited_on
        enum status "visible, hidden"
        timestamptz created_at
        timestamptz updated_at
    }
    VENUE_CLAIM {
        int venue_claim_id PK
        int venue_id FK
        int claimant_id FK
        text contact_info
        text evidence
        enum status "pending, approved, rejected"
        int reviewed_by FK "nullable"
        timestamptz reviewed_at "nullable"
        text review_note "nullable"
        timestamptz created_at
    }
    VENUE_STAFF {
        int venue_id PK, FK
        int user_id PK, FK
        enum role "owner, manager"
        int added_by FK "nullable"
        timestamptz added_at
    }
    PROMOTION {
        int promotion_id PK
        int venue_id FK
        int created_by FK "nullable"
        enum type "featured, offer"
        text title
        text description
        text image_url
        timestamptz starts_at
        timestamptz ends_at
        enum status "draft, pending, active, ended, rejected"
        int reviewed_by FK "nullable"
        timestamptz reviewed_at "nullable"
        text review_note "nullable"
    }
    REVIEW_COMMENT {
        int review_comment_id PK
        int review_id FK
        int user_id FK "nullable"
        int parent_comment_id FK "nullable"
        text text
        boolean is_official
        timestamptz created_at
    }
    PHOTO {
        int photo_id PK
        int venue_id FK "nullable; XOR with review_id"
        int review_id FK "nullable; XOR with venue_id"
        int uploaded_by FK "nullable"
        text url
        timestamptz created_at
    }
    REPORT {
        int report_id PK
        int reporter_id FK "nullable"
        int review_id FK "nullable; exactly one target"
        int comment_id FK "nullable; exactly one target"
        int venue_id FK "nullable; exactly one target"
        text reason
        enum status "open, resolved, dismissed"
        int handled_by FK "nullable"
        timestamptz created_at
    }
    PROMOTION_STAT {
        int promotion_stat_id PK
        int promotion_id FK
        date stat_date
        int impressions
        int clicks
    }
